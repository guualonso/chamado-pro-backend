# Copie para .env (que está no .gitignore) e preencha com valores reais.
# NUNCA versione o arquivo .env.

DB_URL=jdbc:postgresql://localhost:5432/chamado-pro
DB_USERNAME=postgres
DB_PASSWORD=troque-esta-senha

# openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=3600000

# openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Senha inicial do admin (troque após o primeiro acesso)
ADMIN_EMAIL=admin@chamado.com
ADMIN_DEFAULT_PASSWORD=

# Ex.: https://chamadopro.exemplo.com.br (vazio quando servido pelo mesmo domínio)
APP_CORS_ALLOWED_ORIGINS=

WHATSAPP_ENABLED=true
JPA_SHOW_SQL=false
